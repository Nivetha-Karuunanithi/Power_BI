		source =
				let
				    Source = Value.NativeQuery(Snowflake.Databases("CRXETUI-PA01056.snowflakecomputing.com","POWERBI_WH",[Implementation="2.0"]){[Name="DW_QA"]}[Data], "SELECT#(lf)    DATE_HASH_KEY,#(lf)    MY_DATE,#(lf)    TO_VARCHAR(YEAR_MONTH) AS YEAR_MONTH,#(lf)    TO_VARCHAR(YEAR) AS YEAR,#(lf)    MONTH,#(lf)    MONTH_NAME,#(lf)    DAY_OF_MON,#(lf)    DAY_OF_WEEK,#(lf)    WEEK_OF_YEAR,#(lf)    DAY_OF_YEAR#(lf)FROM DW_DEV.PUBLIC.DATE_DIM#(lf)WHERE YEAR >= 2021#(lf)  AND MY_DATE <= CURRENT_DATE()", null, [EnableFolding=true])
				in
				    Source

