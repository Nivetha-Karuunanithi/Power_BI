				    Source = Value.NativeQuery(Snowflake.Databases("CRXETUI-PA01056.snowflakecomputing.com","POWERBI_WH",[Implementation="2.0"]){[Name="DW_QA"]}[Data], "SELECT  #(lf)    DISPLAY_DATE,#(lf)    MY_DATE,#(lf)#(lf)    YEAR(MY_DATE)        AS YEAR,#(lf)    MONTH(MY_DATE)       AS MONTHNUM,#(lf)    DAY(MY_DATE)         AS DAY,#(lf)#(lf)    MONTHNAME(MY_DATE)   AS MONTH,#(lf)    TO_CHAR(MY_DATE, 'YYYY-MON') AS YEARMONTH,#(lf)#(lf)    PLATFORM, #(lf)    PLAN_TYPE,#(lf)    PERIOD,#(lf)    CURRENCY,#(lf)    EVENT,#(lf)    COUNT_SUBSCRIBERS#(lf)#(lf)FROM DW_QA.PUBLIC_TABLEAU.TBL_SUBSCRIBER_MOD_UNIFIED_DAILY", null, [EnableFolding=true])
