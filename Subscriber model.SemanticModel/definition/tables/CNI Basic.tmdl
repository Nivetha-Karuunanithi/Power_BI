table 'CNI Basic'
	lineageTag: b974aaa4-c76a-4f54-bf53-5a38bfaace5b

	measure 'Artist Count' =
			
			COUNT('TBL_CNI_ARTIST'[ARTIST_ID])
		formatString: 0
		lineageTag: 4b607097-b2fe-4775-8bfa-892490a5b15b

	column Date
		formatString: General Date
		lineageTag: fb96fd02-d0d9-487b-bb5d-57655ba42876
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variation
			isDefault
			relationship: bb0b4fc9-5dab-48a5-a276-4bb6132b0234
			defaultHierarchy: LocalDateTable_bc6e976b-1b14-4ad1-bd66-8dd09b7ff5e7.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: string
		lineageTag: 238b5bcf-d930-4bc7-9178-02c29379b7b5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Quarter
		lineageTag: 7d941794-e085-4cc3-918c-1ad73b58b213
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	column Month
		lineageTag: daa545bb-e7d3-4e1f-83dd-cd50b1de8bcf
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]

		annotation SummarizationSetBy = Automatic

	column MonthNo
		formatString: 0
		lineageTag: 1afbab54-fd96-4113-9a0e-605f19c52140
		summarizeBy: sum
		isNameInferred
		sourceColumn: [MonthNo]

		annotation SummarizationSetBy = Automatic

	partition 'CNI Basic' = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN('TBL_CNI_ARTIST'[CREATED]),
				        MAX('TBL_CNI_ARTIST'[CREATED])
				    ),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "MonthNo", MONTH([Date])
				)

	annotation PBI_Id = c48579bf095d4f1ca1e19b442fa33658

